# Jace Recipes. Copy to .env.local for local development and fill in.
# Never commit real values. In production, set these in Vercel → Settings → Environment Variables.

# From Jace (https://jaceo.vercel.app): profile → Manage account → Developer.
# Register "Jace Recipes" with redirect URIs:
#   https://<your-vercel-domain>/api/auth/callback
#   http://localhost:3000/api/auth/callback
JACE_CLIENT_ID=
JACE_CLIENT_SECRET=

# 32+ random characters that encrypt the sign-in cookie. Changing it signs everyone out.
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Neon Postgres connection string (Vercel → Storage → Neon sets this for you).
# Leave empty locally to use a built-in local Postgres (PGlite) in ./data.
DATABASE_URL=

# Optional. This app's public URL, used for the OAuth redirect URI. Defaults to the request's host.
# APP_URL=http://localhost:3000

# Optional. Defaults to https://jaceo.vercel.app. Use http://localhost:4000 with `npm run mock-jace`.
# JACE_URL=http://localhost:4000

# Optional. The Jace username that runs Jace Recipes (default okjace), and, to lock it to one
# Jace account even if that username changes hands, its Jace user id (the "sub" from userinfo).
# ADMIN_USERNAME=okjace
# ADMIN_JACE_SUB=
